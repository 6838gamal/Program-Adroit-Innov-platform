# ===== App =====
APP_NAME=AI Learning Platform
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_URL=http:
SECRET_KEY=change-me-in-production
SESSION_COOKIE_NAME=session
SESSION_MAX_AGE=86400

# ===== Database =====
DATABASE_URL=
PGVECTOR_ENABLED=true

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0

# ===== Google OAuth =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_SCOPE=

# ===== AI Provider =====
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_TUTOR_MAX_TOKENS=1024
AI_CODE_REVIEW_MAX_TOKENS=2048
AI_DEBUG_MAX_TOKENS=1024

# ===== Code Runner =====
RUNNER_URL=http://runner:8001/run
RUNNER_TIMEOUT=15
RUNNER_MEMORY_LIMIT=256m
RUNNER_CPU_LIMIT=1.0

# ===== CORS =====
CORS_ORIGINS=

# ===== Rate Limiting =====
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_AI=20/minute
